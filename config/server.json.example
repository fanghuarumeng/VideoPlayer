{
  "bind_host": "127.0.0.1",
  "http_port": 8080,
  "ws_port": 8081,
  "sqlite_path": "data/videos.db",
  "ingest_interval_ms": 43200000,
  "health_interval_ms": 43200000,
  "url_failure_threshold": 3,
  "ingest_keywords": ["广场舞", "square dance"],
  "authorized_catalog_path": "config/authorized_catalog.example.json",
  "media_root": "data/media",
  "ffmpeg_path": "ffmpeg",
  "upload_workers": 2,
  "thumbnail_workers": 1
}
